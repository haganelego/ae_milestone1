# Large regenerable experiment artifacts (kept out of git; reproducible via scripts/)
# Tracked results: outputs/metrics (CSVs), outputs/figures (PNGs), outputs/analysis,
# data/processed/{selected_images.json,gt_scene_graphs} — small and define the experiment.
data/processed/degraded_images/
data/processed/schedule_compare/
outputs/egtr_predictions/
outputs/llm_ablation/
outputs/vlm_scores/
outputs/llm_scores/
outputs/llm_inputs/
# Archived per-run raw predictions (outputs/runs/<run>/): keep metrics/figures/
# analysis tracked, but exclude the large regenerable prediction/score JSONs.
outputs/runs/*/egtr_predictions/
outputs/runs/*/llm_scores/
outputs/runs/*/vlm_scores/
outputs/runs/*/llm_ablation/
outputs/runs/*/llm_inputs/
.cache_reconstruct/

# Heavy per-image representative panels (~125MB) — kept local, not committed
outputs/figures/representative_*.png

# PGSG (Pix2Grp) runtime: env, converted VG files and raw LAVIS run dirs are regenerable
# (envs/pgsg/.venv is covered by .venv/ above; logs by logs/).
data/processed/pgsg_vg/
outputs/pgsg/runs/
data/processed/robovis2027/degraded_images/

# ROBOVIS2027 bulky per-state outputs (summaries CSV/JSON stay trackable)
outputs/robovis2027/*/graphs*/
outputs/robovis2027/*/raw_responses/

# Held-out MIRU confirmation (configs/config_heldout.yaml)
data/processed/robovis2027_miru/degraded_images/
outputs/robovis2027_miru/egtr_predictions/
